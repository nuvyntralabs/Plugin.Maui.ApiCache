<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <RootNamespace>Plugin.Maui.ApiCache</RootNamespace>
    <AssemblyName>Plugin.Maui.ApiCache</AssemblyName>
    <PackageId>Plugin.Maui.ApiCache</PackageId>
    <Title>.NET MAUI ApiCache — HTTP cache policies for mobile</Title>
    <Description>Lightweight HTTP/API response cache for .NET MAUI on iOS and Android: CacheFirst, NetworkFirst, StaleWhileRevalidate, NetworkOnly, and CacheOnly with a durable on-device store.</Description>
    <PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;http;cache;api-cache;offline;stale-while-revalidate;cache-first;network-first</PackageTags>
    <Authors>Niladri</Authors>
    <Company>MauiEssentials</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NiladriPadhy/Plugin.Maui.ApiCache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NiladriPadhy/Plugin.Maui.ApiCache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.0</Version>
    <PackageReleaseNotes>Initial release: CacheFirst, NetworkFirst, StaleWhileRevalidate, NetworkOnly, and CacheOnly HTTP cache for .NET MAUI.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.ApiCache.Tests" />
  </ItemGroup>

</Project>
